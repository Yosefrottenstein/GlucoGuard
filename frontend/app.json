{
  "expo": {
    "name": "GlucoGuard",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.iphoneappguide.chhlza",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Send your location to emergency contacts during lows",
        "NSBluetoothAlwaysUsageDescription": "Connect to your glucose sensor for live readings",
        "NSContactsUsageDescription": "Pick emergency contacts from your address book"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.iphoneappguide.chhlza",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "NFC",
        "SEND_SMS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Send your location to emergency contacts during lows"
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Connect to your glucose sensor for live readings"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Pick emergency contacts from your address book"
        }
      ],
      "expo-audio",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/classic.wav",
            "./assets/sounds/chime.wav",
            "./assets/sounds/siren.wav",
            "./assets/sounds/pulse.wav",
            "./assets/sounds/gentle.wav",
            "./assets/sounds/alert.wav"
          ]
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Scan your Libre sensor to start live readings",
          "selectIdentifiers": [],
          "includeNdefEntitlement": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
